# PocketBase superuser bootstrap (used by pb_migrations/003_create_superuser.js)
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-this-before-first-run

# Optional deployment/build settings for the Coolify + Docker Compose path.
# Leave VITE_POCKETBASE_URL blank and keep WEB_PROXY_POCKETBASE=1 for same-origin
# deployments where the app proxies PocketBase from the same public domain.
# For split-domain deploys, set VITE_POCKETBASE_URL to the PocketBase origin
# (for example https://admin.example.com) and WEB_PROXY_POCKETBASE=0 so the app
# domain serves only the SPA.
PB_VERSION=
# Containerized deployments should keep PocketBase reachable on the internal network.
# Local host-bound dev can still override this in a private .env if needed.
POCKETBASE_BIND=0.0.0.0:8090
APP_PORT=5180
VITE_POCKETBASE_URL=
WEB_PROXY_POCKETBASE=1

# Legacy/manual deployment placeholders kept for older docs and historical setup notes.
FLASHCARDS_DOMAIN=flashcards.example.com
POCKETBASE_APP_DIR=/opt/flashcards
