# PocketBase superuser bootstrap (used by pb_migrations/003_create_superuser.js)
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-this-before-first-run

# Deployment placeholders referenced by the example docs/configs
FLASHCARDS_DOMAIN=flashcards.example.com
POCKETBASE_BIND=127.0.0.1:8090
POCKETBASE_APP_DIR=/opt/flashcards

# Optional override if the app is not served from the same origin as PocketBase.
# The Vite dev server and the example nginx config both proxy /api to PocketBase,
# so this can usually be left blank.
VITE_POCKETBASE_URL=

# Optional PocketBase release pin for the auto-download helper (leave blank for latest).
PB_VERSION=

# Optional future SMTP settings for password-reset email flows
PB_SMTP_ENABLED=false
PB_SMTP_HOST=
PB_SMTP_PORT=
PB_SMTP_USERNAME=
PB_SMTP_PASSWORD=
PB_SMTP_TLS=true
PB_SMTP_FROM=quranic-flashcards@example.com
