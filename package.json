{
  "name": "arabic-flashcards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "node scripts/dev-with-pocketbase.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/run-tests.mjs",
    "smoke:pocketbase": "node scripts/pocketbase-smoke-test.mjs",
    "smoke:compose": "node scripts/coolify-compose-smoke.mjs",
    "generate-audio": "python3 scripts/generate_audio_gcp.py --out public/audio",
    "generate-audio:sample": "python3 scripts/generate_audio_gcp.py --out public/audio --sample 10",
    "generate-audio:manifest": "python3 scripts/generate_audio_gcp.py --out public/audio --manifest-only",
    "check-audio-coverage": "python3 scripts/check_audio_coverage.py",
    "generate-audio:coverage": "python3 scripts/generate_audio_gcp.py --out public/audio --manifest-only && python3 scripts/check_audio_coverage.py"
  },
  "dependencies": {
    "svelte": "^4.0.0"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "svelte-preprocess": "^5.0.0",
    "typescript": "^5.0.0"
  }
}
